# Copy to $DEPLOY_PATH/.env on the VPS and fill in real values. Never commit the real file.

# Local PostgreSQL (PostGIS) container — the app connects to it automatically.
# Only applied when the database volume is first created; changing it later does not change the DB password.
# Avoid "$" in values (Docker Compose treats it as a variable), e.g. use `openssl rand -hex 24`
POSTGRES_DB=smart_bus_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Base64-encoded, must decode to at least 32 bytes (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me

# Host port the API is published on
APP_PORT=8080
